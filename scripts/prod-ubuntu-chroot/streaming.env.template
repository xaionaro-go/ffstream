
WIDTH=1920
HEIGHT=1080
ACODEC=aac
VCODEC="$(cat /etc/streaming.vcodec)"
FRAMERATE=30
KEYFRAME_INTERVAL=1
BFRAMES=0
OUTPUT_NAME=noguri/input0
MIN_BITRATE=1M
INPUT_PROTOCOL=rtmp
OUTPUT_PROTOCOL=rtsp
OUTPUT_PROTOCOL=rtmp
#OUTPUT_PROTOCOL=srt
OUTPUT_RTSP_TRANSPORT=tcp
#OUTPUT_RTSP_TRANSPORT=udp
OUTPUT_RTSP_PACKET_SIZE=1100
OUTPUT_SRT_PACKET_SIZE=$[ 188 * 5 ]
TARGET_LATENCY=1000000
OUTPUT_SRT_URL_APPEND="&latency=${TARGET_LATENCY}&pkt_size=${OUTPUT_SRT_PACKET_SIZE}&nakreport=1&inputbw=600000&transtype=live"
#OUTPUT_SRT_URL_APPEND=
STREAMING_TOOL=ffstream
#STREAMING_TOOL=ffmpeg
FFSTREAM_LOG_LEVEL=info
#FFSTREAM_LOG_LEVEL=debug
#FFSTREAM_LOG_LEVEL=trace
FFSTREAM_OPTS=(-hwaccel mediacodec)
FFSTREAM_RETRY_OUTPUT_ON_FAILURE=false
FFSTREAM_AUTO_BITRATE=true
#FFSTREAM_AUTO_BYPASS=true
FFSTREAM_AUTO_BYPASS=false
FFSTREAM_AUTOBITRATE_MAX_HEIGHT="$HEIGHT"
FFSTREAM_AUTOBITRATE_MIN_HEIGHT=180
#FFSTREAM_OPTS=()
FFMPEG_LOG_LEVEL=info
ADDR_HOME=192.168.0.134
ADDR_DANUSYA=192.168.0.134
#ADDR_HOME=192.168.0.131
AVOID_FFSTREAM_FOR_ENCODING=0
MOVFLAGS_SRT=frag_keyframe+empty_moov+separate_moof
PARALLEL_CHANNELS_HOME=1
PARALLEL_CHANNELS=3
ADJUST_TO_N_BEST=1
HOME_WIFI_BYPASS_WG=0

# Termux ffstream binary launched from both prod wrappers.
FFSTREAM_BIN=/data/user/0/com.termux/files/usr/bin/ffstream
FFSTREAM_BIN_RUNNER=termux-root

# Address-space cap enforced via prlimit --as in both prod wrappers.
# hardened_malloc in the Termux ffstream process reserves roughly 1 TiB of
# virtual address space at startup; use unlimited unless an operator has a
# measured higher-than-1TiB numeric cap.
FFSTREAM_RAM_CAP_AS=unlimited
# Go runtime soft memory target; lets the runtime self-regulate before VAS hits.
FFSTREAM_GOMEMLIMIT=15GiB
