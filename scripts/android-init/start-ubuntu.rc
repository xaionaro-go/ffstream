# Android init.rc service that auto-mounts the /data/ubuntu chroot and
# fires the chroot's /etc/rc.local supervisor stack after every boot.
#
# Replaces the Termux:Boot trigger (scripts/termux-boot/start-ubuntu)
# on devices where Termux:Boot's untrusted_app SELinux context cannot
# escalate to root via /system/xbin/su (the AOSP-standard SELinux
# constraint on stock-userdebug Pixels).
#
# The init context runs services as root with `seclabel u:r:su:s0` —
# the only SELinux domain on userdebug that can both (a) read
# /data/ubuntu/ (label system_data_root_file, MAC-restricted) and
# (b) call setenforce permissive (which /data/ubuntu/start.sh does
# as its first action before chrooting and execing rc.local).
#
# Scope: VERIFIED on the akita test phone (41041JEKB08092, stock
# Google Pixel 8a userdebug Android 16 fingerprint
# google/akita/akita:16/BP4A.260205.001/2026031700:userdebug/release-keys).
#
# Prod-phone caveat: the `u:r:su:s0` SELinux context exists on
# userdebug builds but may be ABSENT on user-build prod phones. If the
# prod phone (172.29.222.3, IP from mission.md) is a user-build, this
# .rc file's seclabel will fail at service-start time with
# "seclabel u:r:su:s0 not found in policy" or similar. Re-validation
# at Task #7 prod-phone-validation dispatch is required before
# vendoring this file onto the prod phone.
#
# Install:
#   adb root && adb remount    # one-time, requires reboot to activate overlayfs
#   adb reboot
#   adb wait-for-device
#   adb root && adb remount    # re-arm post-reboot (overlayfs scratch is now active)
#   adb push scripts/android-init/start-ubuntu.rc /system/etc/init/start-ubuntu.rc
#   adb shell chmod 0644 /system/etc/init/start-ubuntu.rc
#   adb shell chcon u:object_r:system_file:s0 /system/etc/init/start-ubuntu.rc
#   adb reboot                 # fires service for the first time
#
# Rollback (defensive — if /data/ubuntu/start.sh starts misbehaving):
#   adb root && adb remount
#   adb shell rm /system/etc/init/start-ubuntu.rc
#   adb reboot
#
# init.rc service syntax reference:
#   AOSP system/core/init/README.md (in-tree, current branch)
#
# Trigger semantics:
# - `class late_start` puts this service in the post-Zygote-up cohort,
#   running well after core-system services so /data is decrypted and
#   userdata is fully available when start.sh runs.
# - `oneshot` prevents respawn-on-exit; the service runs ONCE per boot.
#   /data/ubuntu/start.sh itself backgrounds the chroot supervisors
#   via `( ... ) &`, so the service exits cleanly while the
#   supervisors continue running in the background.
# - `disabled` keeps the service inert until the explicit
#   `start start-ubuntu` action below; necessary because `class
#   late_start` would otherwise auto-start it on the late_start
#   class trigger (which fires after Zygote, but BEFORE userdata is
#   fully unlocked on FBE devices).
# - `on property:sys.boot_completed=1` fires AFTER user unlock + FBE
#   decrypt, ensuring /data/ubuntu/ is readable when start.sh runs.

service start-ubuntu /system/bin/sh /data/ubuntu/start.sh
    class late_start
    oneshot
    user root
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    start start-ubuntu
